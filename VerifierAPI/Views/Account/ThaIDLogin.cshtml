
<!doctype html>
<html lang="th">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>เอกสาร STANDARD VC</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --navy: #0a1f6b;
            --blue-dark: #14276e;
            --blue-light: #5b8def;
            --border-blue: #1a2f7a;
            --text-gray: #8a8a8a;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            height: 100%;
            overflow: hidden;
        }

        body {
            font-family: "Kanit", "Sarabun", "Noto Sans Thai", Arial, sans-serif;
            background: #ffffff;
            height: 100dvh;
            display: flex;
            flex-direction: column;
        }

        header.topbar {
            background: var(--navy);
            color: #fff;
            padding: clamp(10px, 2.5vh, 20px) 24px;
            display: flex;
            align-items: center;
            flex-shrink: 0;
        }

            header.topbar h1 {
                font-size: clamp(16px, min(2.6vw, 2.4vh), 26px);
                font-weight: 700;
            }

        main {
            flex: 1;
            min-height: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: clamp(10px, 3vh, 40px) 16px;
            overflow: hidden;
        }

        .login-card {
            width: 100%;
            max-width: 1003px;
            max-height: 100%;
            border: 2px solid var(--border-blue);
            border-radius: 20px;
            padding: clamp(18px, 5vh, 58px) clamp(16px, 4vw, 32px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: clamp(10px, 2.5vh, 20px);
            overflow: hidden;
        }

            .login-card .title {
                text-align: center;
                color: var(--navy);
            }

                .login-card .title .line1 {
                    font-size: clamp(18px, min(3.5vw, 4.2vh), 38px);
                    font-weight: 700;
                    margin-bottom: 6px;
                }

                .login-card .title .line2 {
                    font-size: clamp(18px, min(3.5vw, 4.2vh), 38px);
                    font-weight: 800;
                    letter-spacing: 1px;
                }

        .thaid-panel {
            width: 100%;
            max-width: 620px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: clamp(12px, 3vh, 28px);
        }

        .thaid-desc {
            text-align: center;
            color: var(--text-gray);
            font-size: clamp(12px, min(2vw, 1.8vh), 15px);
            line-height: 1.5;
            max-width: 480px;
        }

        .thaid-btn {
            width: 100%;
            max-width: 400px;
            height: clamp(48px, min(10vw, 8vh), 76px);
            padding: 0 24px;
            border: none;
            border-radius: 12px;
            font-size: clamp(14px, min(2.2vw, 2vh), 18px);
            font-weight: 600;
            color: #fff;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            text-decoration: none;
            background: linear-gradient( 90deg, var(--blue-dark) 0%, var(--blue-light) 100% );
            transition: opacity 0.2s, transform 0.1s;
        }

            .thaid-btn:hover {
                opacity: 0.92;
            }

            .thaid-btn:active {
                transform: scale(0.98);
            }

            .thaid-btn .icon {
                width: clamp(22px, min(4vw, 3.6vh), 28px);
                height: clamp(22px, min(4vw, 3.6vh), 28px);
                border-radius: 6px;
                background: #fff;
                color: var(--navy);
                font-weight: 800;
                font-size: 13px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

        /* All sizing above is fluid (clamp, bounded by both vw and vh), so the
           card always scales down to fit the viewport instead of overflowing —
           no width/height breakpoints needed to avoid a scrollbar. Kept a
           small-width tweak only for the border radius, which doesn't have a
           natural fluid equivalent. */
        @@media (max-width: 380px) {
            .login-card {
                border-radius: 16px;
            }
        }</style>
</head>
<body>
    <header class="topbar">
        <h1>ตรวจสอบเอกสาร STANDARD VC</h1>
    </header>

    <main>
        <div class="login-card">
            <div class="title">
                <div class="line1">เอกสาร</div>
                <div class="line2">STANDARD VC</div>
            </div>

            <div class="thaid-panel">
                <p class="thaid-desc">
                    กรุณายืนยันตัวตนด้วยแอปพลิเคชัน ThaID เพื่อเข้าสู่ระบบและตรวจสอบเอกสาร Standard VC
                </p>

                @{
                    var returnUrl = ViewBag.ReturnUrl as string;
                    var documentType = ViewBag.DocumentType as string;
                    var loginUrl = "/thaiid/login";

                    var queryParams = new System.Collections.Generic.List<string>();
                    if (!string.IsNullOrWhiteSpace(returnUrl))
                    {
                        queryParams.Add("returnUrl=" + Html.Raw(System.Net.WebUtility.UrlEncode(returnUrl)));
                    }
                    if (!string.IsNullOrWhiteSpace(documentType))
                    {
                        queryParams.Add("documentType=" + Html.Raw(System.Net.WebUtility.UrlEncode(documentType)));
                    }
                    if (queryParams.Count > 0)
                    {
                        loginUrl += "?" + string.Join("&", queryParams);
                    }
                }

                <a href="@loginUrl" class="thaid-btn">
                    <span class="icon">ID</span>
                    <span>เข้าสู่ระบบด้วย ThaID</span>
                </a>
            </div>
        </div>
    </main>
</body>
</html>
