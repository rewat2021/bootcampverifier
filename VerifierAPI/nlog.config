<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn">

  <targets>
    
    <!-- Log File -->
    <!-- FIX (audit trail follow-up, 2026-08-15): this had no retention policy at
         all — logs/{date}.log files accumulated forever with nothing to clean
         them up, and being free-text they're not a substitute for the
         structured dbverifierlog audit trail (see VerifierAuditLogFilter) —
         just a supplementary diagnostic trail. maxArchiveFiles below keeps the
         last 90 daily files and deletes older ones automatically; adjust to
         match whatever retention period is actually required. -->
    <target xsi:type="File"
            name="logfile"
            fileName="logs/${shortdate}.log"
            archiveFileName="logs/archive/{#}.log"
            archiveEvery="Day"
            archiveNumbering="Date"
            archiveDateFormat="yyyy-MM-dd"
            maxArchiveFiles="90"
            concurrentWrites="true"
            layout="${longdate}|${level}|${logger}|${message} ${exception}" />

    <!-- Console -->
    <target xsi:type="Console"
            name="console"
            layout="${longdate}|${level}|${message}" />

  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="logfile,console" />
  </rules>

</nlog>