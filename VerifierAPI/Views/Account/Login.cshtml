<!doctype html>
<html lang="th">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>เอกสาร STANDARD VC</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --navy: #0a1f6b;
            --blue-dark: #14276e;
            --blue-light: #5b8def;
            --border-blue: #1a2f7a;
            --text-gray: #8a8a8a;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            overflow-x: hidden;
        }

        body {
            font-family: "Kanit", "Sarabun", "Noto Sans Thai", Arial, sans-serif;
            background: #ffffff;
            min-height: 100vh;
        }

        header.topbar {
            background: var(--navy);
            color: #fff;
            padding: 20px 24px;
            display: flex;
            align-items: center;
        }

            header.topbar h1 {
                font-size: clamp(18px, 2.6vw, 26px);
                font-weight: 700;
            }

        main {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 16px;
            min-height: calc(100vh - 76px);
        }

        .login-card {
            width: 100%;
            max-width: 1003px;
            border: 2px solid var(--border-blue);
            border-radius: 20px;
            padding: 58px 32px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }

            .login-card form {
                max-width: 620px;
            }

            .login-card .title {
                text-align: center;
                color: var(--navy);
            }

                .login-card .title .line1 {
                    font-size: clamp(20px, 3.5vw, 38px);
                    font-weight: 700;
                    margin-bottom: 6px;
                }

                .login-card .title .line2 {
                    font-size: clamp(20px, 3.5vw, 38px);
                    font-weight: 800;
                    letter-spacing: 1px;
                }

        form {
            width: 100%;
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .fields {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 20px;
            align-items: center;
        }

        .input-group {
            width: 579px;
            max-width: 100%;
        }

            .input-group input {
                width: 100%;
                height: 76px;
                padding: 0 20px;
                border: 1.5px solid #cfd4e0;
                border-radius: 12px;
                font-size: 14px;
                outline: none;
                transition: border-color 0.2s, box-shadow 0.2s;
            }

                .input-group input:focus {
                    border-color: var(--blue-light);
                    box-shadow: 0 0 0 3px rgba(91, 141, 239, 0.2);
                }

                .input-group input::placeholder {
                    color: var(--text-gray);
                }

        .submit-btn {
            margin-top: 16px;
            width: 300px;
            max-width: 100%;
            height: 55px;
            padding: 0 24px;
            border: none;
            border-radius: 999px;
            font-size: 14px;
            font-weight: 500;
            color: #fff;
            cursor: pointer;
            background: linear-gradient( 90deg, var(--blue-dark) 0%, var(--blue-light) 100% );
            transition: opacity 0.2s, transform 0.1s;
        }

            .submit-btn:hover {
                opacity: 0.92;
            }

            .submit-btn:active {
                transform: scale(0.98);
            }

        /* Responsive breakpoints */
        @@media (max-width: 768px) {
            .login-card {
                min-height: 560px;
                padding: 44px 28px;
                gap: 36px;
            }

            .input-group input {
                height: 68px;
            }

            .submit-btn {
                height: 52px;
            }
        }

        @@media (max-width: 600px) {
            .login-card {
                min-height: unset;
                padding: 36px 20px;
                border-radius: 16px;
                gap: 24px;
            }

            .input-group input {
                height: 64px;
                padding: 0 16px;
            }

            header.topbar {
                padding: 16px 20px;
            }
        }

        @@media (max-width: 380px) {
            .login-card {
                padding: 28px 14px;
            }

            .submit-btn {
                height: 50px;
            }
        }

        /* Short / landscape viewports */
        @@media (max-height: 700px) {
            .login-card {
                min-height: unset;
            }

            main {
                padding: 24px 16px;
            }
        }</style>
</head>
<body>
    <header class="topbar">
        <h1>ระบบสมัครงาน TechCorp Thailand</h1>
    </header>

    <main>
        <div class="login-card">
            <div class="title">
                <div class="line1">ตรวจสอบเอกสาร</div>
                <div class="line2">STANDARD VC</div>
            </div>


            @using (Html.BeginForm(new { @class = "login100-form validate-form" }))
            {
                <div class="fields">
                    <div class="input-group">
                        <input type="text"
                               name="username"
                               placeholder="Username"
                               autocomplete="username" />
                    </div>
                    <div class="input-group">
                        <input type="password"
                               name="password"
                               placeholder="Password"
                               autocomplete="current-password" />
                    </div>
                </div>
                <button type="submit" class="submit-btn">เข้าสู่ระบบ</button>
            }

        </div>
    </main>
</body>
</html>
